# ── New Relic ────────────────────────────────────────────────────────────────
# Your New Relic ingest license key.
# Found at: one.newrelic.com → (user menu) → API Keys → INGEST - LICENSE
NR_LICENSE_KEY=your_license_key_here

# Optional: override the New Relic region endpoint (default is US).
# Set to "staging" or "eu" if needed.
# NRIA_COLLECTOR_URL=https://infra-api.eu.newrelic.com

# ── Local PostgreSQL ──────────────────────────────────────────────────────────
PG_USER=postgres
PG_PASSWORD=e2e_test_password
PG_DB=demo

# ── Aurora / Remote PostgreSQL (only needed for aurora testing) ───────────────
# AURORA_HOST=your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com
# AURORA_PORT=5432
# AURORA_USER=your_db_user
# AURORA_PASSWORD=your_db_password
# AURORA_DB=postgres
# AURORA_SSL=true
